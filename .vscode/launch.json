{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API Server",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "api-server: build",
      "program": "${workspaceFolder}/artifacts/api-server/dist/index.mjs",
      "outFiles": ["${workspaceFolder}/artifacts/api-server/dist/**/*.mjs"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "NODE_ENV": "development" },
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open Web App (rehab-tracker)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/artifacts/rehab-tracker/src"
    }
  ]
}
