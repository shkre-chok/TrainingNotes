# Copy this file to `.env` and adjust as needed. `.env` is gitignored.
# See docs/LOCAL_DEV.md for the full setup walkthrough.

# --- Database ---
# Matches the defaults in docker-compose.yml — if you change one, change both.
DATABASE_URL=postgresql://trainingnotes:trainingnotes@localhost:5432/trainingnotes

# --- API server ---
NODE_ENV=development
# Used to build absolute links (e.g. homework magic links) outside of Replit,
# where REPLIT_DEV_DOMAIN isn't set.
APP_URL=http://localhost:8080

# --- Local dev ports (used by the root `pnpm dev:*` scripts) ---
API_PORT=8080
WEB_PORT=5173

# --- Object storage ---
# "local"  - store uploads on disk under OBJECT_STORAGE_LOCAL_DIR. No cloud
#            credentials needed, works out of the box.
# "gcs"    - use a real Google Cloud Storage bucket. Requires GOOGLE_APPLICATION_CREDENTIALS
#            (or equivalent ADC setup) plus PUBLIC_OBJECT_SEARCH_PATHS / PRIVATE_OBJECT_DIR
#            pointing at real bucket paths. This is the same backend Replit's
#            sidecar talks to, just authenticated the standard way instead.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=.data/objects

# --- Email ---
# "console" - log the reminder email to the terminal instead of sending it.
# "gmail"   - send via the Gmail connector (only works when running on Replit).
EMAIL_DRIVER=console
